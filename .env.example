# --- Core ---
DATABASE_URL="postgresql://user:password@localhost:5432/yoinsta"
REDIS_URL="redis://localhost:6379"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# --- Google login (Phase 1) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- YouTube channel connect (Phase 1) ---
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""

# --- Instagram / Meta (Phase 3) ---
META_APP_ID=""
META_APP_SECRET=""

# --- Security ---
# 32-byte key for AES-256-GCM, base64 encoded. Generate: openssl rand -base64 32
ENCRYPTION_KEY=""

# --- Admin (see section 6 of the spec — do not add any other way to grant this) ---
ADMIN_EMAILS="owner@yoinsta.app"
ADMIN_PIN="set-a-strong-numeric-or-alnum-pin"
